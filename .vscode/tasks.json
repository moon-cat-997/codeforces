{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "cf: build debug (active file)",
            "command": "${workspaceFolder}/scripts/cxx-build.sh",
            "args": [
                "${file}",
                "/tmp/cf_debug_bin"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Portable debug build (picks the right g++ per OS) to /tmp/cf_debug_bin"
        }
    ]
}
